{
  "name": "eslint-config-contactlab",
  "version": "13.0.0",
  "description": "Contactlab ESLint configuration",
  "main": "index.js",
  "author": "Contactlab",
  "license": "Apache-2.0",
  "repository": "contactlab/eslint-config-contactlab",
  "homepage": "https://contactlab.github.io/eslint-config-contactlab",
  "bugs": "https://github.com/contactlab/eslint-config-contactlab/issues",
  "keywords": [
    "eslint",
    "eslintconfig",
    "tslint",
    "contactlab"
  ],
  "engines": {
    "node": ">= 20.x",
    "npm": ">= 9.8.1"
  },
  "files": [
    "index.js",
    "typescript.js"
  ],
  "scripts": {
    "prepare": "husky",
    "pretest": "npm run build",
    "test:es": "ESLINT_USE_FLAT_CONFIG=false eslint ./test/. -c ./test/_config.es.json --ext .js,.jsx",
    "test:ts": "ESLINT_USE_FLAT_CONFIG=false eslint ./test/. -c ./test/_config.ts.json --ext .ts,.tsx",
    "test": "npm run test:es && npm run test:ts",
    "prebuild": "rm -f ./index.js ./typescript.js",
    "build": "tsc",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.39.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.6.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@typescript-eslint/typescript-estree": "^8.47.0",
    "eslint-plugin-fp-ts": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.2.1",
    "eslint-plugin-n": "^17.23.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "eslint": "^9.39.1",
    "husky": "^9.0.11",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
