{
  "name": "eslint-config-contactlab",
  "version": "12.0.0",
  "description": "Contactlab ESLint configuration",
  "main": "index.js",
  "author": "Contactlab",
  "license": "Apache-2.0",
  "repository": "contactlab/eslint-config-contactlab",
  "homepage": "https://contactlab.github.io/eslint-config-contactlab",
  "bugs": "https://github.com/contactlab/eslint-config-contactlab/issues",
  "keywords": [
    "eslint",
    "eslintconfig",
    "tslint",
    "contactlab"
  ],
  "engines": {
    "node": ">= 18.18",
    "npm": ">= 9.8.1"
  },
  "files": [
    "index.js",
    "typescript.js"
  ],
  "scripts": {
    "prepare": "husky",
    "pretest": "npm run build",
    "test:es": "ESLINT_USE_FLAT_CONFIG=false eslint ./test/. -c ./test/_config.es.json --ext .js,.jsx",
    "test:ts": "ESLINT_USE_FLAT_CONFIG=false eslint ./test/. -c ./test/_config.ts.json --ext .ts,.tsx",
    "test": "npm run test:es && npm run test:ts",
    "prebuild": "rm -f ./index.js ./typescript.js",
    "build": "tsc",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.21.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^3.1.0",
    "@stylistic/eslint-plugin-js": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@typescript-eslint/typescript-estree": "^8.26.0",
    "eslint-plugin-fp-ts": "^0.4.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-n": "^17.16.2"
  },
  "devDependencies": {
    "@types/node": "^20.5.7",
    "eslint": "^9.21.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
