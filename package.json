{
  "name": "eslint-config-contactlab",
  "version": "13.0.0",
  "description": "Contactlab ESLint configuration",
  "main": "./dist/index.js",
  "author": "Contactlab",
  "license": "Apache-2.0",
  "repository": "contactlab/eslint-config-contactlab",
  "homepage": "https://contactlab.github.io/eslint-config-contactlab",
  "bugs": "https://github.com/contactlab/eslint-config-contactlab/issues",
  "keywords": [
    "eslint",
    "eslintconfig",
    "tslint",
    "contactlab"
  ],
  "engines": {
    "node": ">= 20.x",
    "npm": ">= 9.8.1"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "pretest": "npm run build",
    "test:es": "eslint ./test/. --ext .js,.jsx",
    "test:ts": "eslint ./test/. --ext .ts,.tsx",
    "test": "npm run test:es && npm run test:ts",
    "prebuild": "rm -f ./dist/*.js ./dist/*.d.ts",
    "build": "tsc",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "eslint": "^9.39.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.6.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "eslint-plugin-fp-ts": "^0.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.2.1",
    "eslint-plugin-n": "^17.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "husky": "^9.0.11",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
